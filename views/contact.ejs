<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - FreshMarket</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            background: url('/images/backgrounds/landing.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }
        body::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(255, 255, 255, 0.3);
            z-index: 0;
        }
        .nav, .container { position: relative; z-index: 1; }
        .nav { background:rgba(255,255,255,.98); padding:1rem 0; box-shadow:0 2px 20px rgba(0,0,0,.1); }
        .container { width:90%; max-width:1200px; margin:2rem auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-size:1.8rem; font-weight:900; color:#667eea; }
        .nav-links { display:flex; gap:1.5rem; }
        .nav-links a { color:#333; text-decoration:none; font-weight:600; padding:.5rem 1rem; border-radius:.5rem; transition:all .2s; }
        .nav-links a:hover { background:#667eea; color:#fff; }
        
        .contact-section {
            background: rgba(255,255,255,0.95);
            border-radius: 1rem;
            padding: 3rem;
            box-shadow: 0 8px 30px rgba(0,0,0,0.1);
        }
        h1 { color: #667eea; margin-bottom: 1rem; font-size: 2.5rem; }
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            margin-top: 2rem;
        }
        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        .info-box {
            background: #f8fafc;
            padding: 1.5rem;
            border-radius: .7rem;
            border-left: 4px solid #667eea;
        }
        .info-box h3 { color: #667eea; margin-bottom: .5rem; }
        .info-box p { color: #555; line-height: 1.6; }
        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .form-group label { display: block; margin-bottom: .5rem; font-weight: 600; color: #333; }
        .form-group input, .form-group textarea {
            width: 100%;
            padding: .9rem;
            border: 2px solid #e2e8f0;
            border-radius: .5rem;
            font-size: 1rem;
        }
        .form-group textarea { resize: vertical; min-height: 150px; }
        .btn-submit {
            padding: 1rem 2rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border: none;
            border-radius: .7rem;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all .3s;
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(102,126,234,.4); }
        
        @media (max-width: 768px) {
            .contact-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">🛒 FreshMarket</div>
                <div class="nav-links">
                    <a href="/">Home</a>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                    <% if (user) { %>
                        <a href="<%= user.role === 'admin' ? '/inventory' : '/shopping' %>">
                            <%= user.role === 'admin' ? 'Inventory' : 'Shop' %>
                        </a>
                        <a href="/logout">Logout</a>
                    <% } else { %>
                        <a href="/login">Login</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="contact-section">
            <h1>Contact Us</h1>
            <p>Have a question? We'd love to hear from you. Send us a message and we'll respond as soon as possible.</p>

            <div class="contact-grid">
                <div class="contact-info">
                    <div class="info-box">
                        <h3>📧 Email</h3>
                        <p>support@freshmarket.com</p>
                    </div>
                    <div class="info-box">
                        <h3>📞 Phone</h3>
                        <p>+65 1234 5678</p>
                        <p>Mon-Fri: 9am - 6pm</p>
                    </div>
                    <div class="info-box">
                        <h3>📍 Address</h3>
                        <p>123 Market Street</p>
                        <p>Singapore 123456</p>
                    </div>
                    <div class="info-box">
                        <h3>⏰ Business Hours</h3>
                        <p>Monday - Friday: 8am - 8pm</p>
                        <p>Saturday - Sunday: 9am - 6pm</p>
                    </div>
                </div>

                <div class="contact-form">
                    <h2 style="color:#667eea;margin-bottom:1rem">Send us a message</h2>
                    <form action="/contact" method="POST">
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" name="name" required placeholder="Your name">
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" name="email" required placeholder="your@email.com">
                        </div>
                        <div class="form-group">
                            <label>Subject</label>
                            <input type="text" name="subject" required placeholder="What is this about?">
                        </div>
                        <div class="form-group">
                            <label>Message</label>
                            <textarea name="message" required placeholder="Your message..."></textarea>
                        </div>
                        <button type="submit" class="btn-submit">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
