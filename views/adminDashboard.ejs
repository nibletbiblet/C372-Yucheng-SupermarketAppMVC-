<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - FreshMarket</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #e0f7fa 0%, #e1bee7 100%); display:flex; min-height:100vh; }
        
        /* Sidebar */
        .sidebar {
            width: 250px;
            background: #fff;
            box-shadow: 2px 0 10px rgba(0,0,0,.1);
            padding: 2rem 0;
        }
        .logo {
            padding: 0 1.5rem 2rem;
            font-size: 1.5rem;
            font-weight: 900;
            color: #667eea;
            border-bottom: 2px solid #f1f5f9;
        }
        .nav-item {
            display: flex;
            align-items: center;
            padding: 1rem 1.5rem;
            color: #64748b;
            text-decoration: none;
            transition: all .3s;
            cursor: pointer;
        }
        .nav-item:hover, .nav-item.active {
            background: linear-gradient(90deg, #667eea15, transparent);
            color: #667eea;
            border-left: 4px solid #667eea;
        }
        .nav-icon { font-size: 1.3rem; margin-right: .8rem; }
        
        /* Main Content */
        .main-content { flex: 1; padding: 2rem; overflow-y: auto; }
        .header {
            background: #fff;
            padding: 1.5rem 2rem;
            border-radius: 1rem;
            margin-bottom: 2rem;
            box-shadow: 0 2px 10px rgba(0,0,0,.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .welcome { font-size: 1.8rem; color: #333; }
        .user-info { display: flex; align-items: center; gap: 1rem; }
        
        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: #fff;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 4px 15px rgba(0,0,0,.08);
            display: flex;
            align-items: center;
            gap: 1.5rem;
            transition: all .3s;
        }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(0,0,0,.12); }
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }
        .stat-icon.blue { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
        .stat-icon.green { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
        .stat-icon.orange { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; }
        .stat-icon.red { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
        .stat-info h3 { color: #64748b; font-size: .9rem; font-weight: 600; margin-bottom: .3rem; }
        .stat-info .value { font-size: 2rem; font-weight: 700; color: #333; }
        
        /* Charts Section */
        .charts-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        .chart-card {
            background: #fff;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 4px 15px rgba(0,0,0,.08);
        }
        .chart-title { font-size: 1.2rem; color: #333; margin-bottom: 1.5rem; font-weight: 700; }
        
        /* Recent Activity */
        .activity-item {
            padding: 1rem;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .activity-item:last-child { border-bottom: none; }
        .activity-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
        }
        
        /* Quick Actions */
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }
        .action-btn {
            padding: 1rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border: none;
            border-radius: .7rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .3s;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }
        .action-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(102,126,234,.4); }
        
        @media (max-width: 768px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; }
            .charts-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo">🛒 FreshMarket Admin</div>
        <a href="/admin/dashboard" class="nav-item active">
            <span class="nav-icon">📊</span> Dashboard
        </a>
        <a href="/inventory" class="nav-item">
            <span class="nav-icon">📦</span> Inventory
        </a>
        <a href="/admin/users" class="nav-item">
            <span class="nav-icon">👥</span> Manage Users
        </a>
        <a href="/admin/orders" class="nav-item">
            <span class="nav-icon">🛍️</span> Orders
        </a>
        <a href="/admin/reports" class="nav-item">
            <span class="nav-icon">📈</span> Reports
        </a>
        <a href="/" class="nav-item">
            <span class="nav-icon">🏠</span> Home
        </a>
        <a href="/logout" class="nav-item">
            <span class="nav-icon">🚪</span> Logout
        </a>
    </div>

    <div class="main-content">
        <div class="header">
            <h1 class="welcome">Welcome back, <%= user.username %>! 👋</h1>
            <div class="user-info">
                <span style="color:#64748b;">Admin Panel</span>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">👥</div>
                <div class="stat-info">
                    <h3>Total Users</h3>
                    <div class="value"><%= stats.totalUsers %></div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">📦</div>
                <div class="stat-info">
                    <h3>Total Products</h3>
                    <div class="value"><%= stats.totalProducts %></div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">🛍️</div>
                <div class="stat-info">
                    <h3>Total Orders</h3>
                    <div class="value"><%= stats.totalOrders %></div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon red">💰</div>
                <div class="stat-info">
                    <h3>Total Revenue</h3>
                    <div class="value">$<%= stats.totalRevenue.toFixed(2) %></div>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div class="charts-grid">
            <div class="chart-card">
                <h2 class="chart-title">Recent Orders</h2>
                <% if (recentOrders.length > 0) { %>
                    <% recentOrders.forEach(order => { %>
                        <div class="activity-item">
                            <div class="activity-icon">🛍️</div>
                            <div style="flex:1;">
                                <strong>Order #<%= order.order_id %></strong>
                                <p style="color:#64748b;font-size:.9rem;"><%= order.username %> - $<%= parseFloat(order.total_price).toFixed(2) %></p>
                            </div>
                            <small style="color:#999;"><%= new Date(order.created_at).toLocaleDateString() %></small>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="text-align:center;color:#999;padding:2rem;">No orders yet</p>
                <% } %>
            </div>

            <div class="chart-card">
                <h2 class="chart-title">Low Stock Alert</h2>
                <% if (lowStockProducts.length > 0) { %>
                    <% lowStockProducts.forEach(product => { %>
                        <div class="activity-item">
                            <div class="activity-icon">⚠️</div>
                            <div style="flex:1;">
                                <strong><%= product.productName %></strong>
                                <p style="color:#ef4444;font-size:.9rem;">Only <%= product.quantity %> left</p>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="text-align:center;color:#999;padding:2rem;">All products in stock ✅</p>
                <% } %>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="chart-card">
            <h2 class="chart-title">Quick Actions</h2>
            <div class="quick-actions">
                <a href="/addProduct" class="action-btn">➕ Add Product</a>
                <a href="/inventory" class="action-btn">📦 View Inventory</a>
                <a href="/admin/users" class="action-btn">👥 Manage Users</a>
                <a href="/admin/orders" class="action-btn">🛍️ View Orders</a>
            </div>
        </div>
    </div>
</body>
</html>
