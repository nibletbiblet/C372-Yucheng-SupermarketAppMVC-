<!-- product.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.productName %> - FreshMarket</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            background: url('/images/backgrounds/user.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', sans-serif;
        }
        body::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(255, 255, 255, 0.3);
            z-index: 0;
        }
        .nav, .container { position: relative; z-index: 1; }
        .nav { background:rgba(255,255,255,.98); padding:1rem 0; box-shadow:0 2px 20px rgba(0,0,0,.1); }
        .container { width:90%; max-width:1200px; margin:2rem auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-size:1.5rem; font-weight:900; color:#667eea; }
        .nav-links { display:flex; gap:1rem; }
        .nav-links a { color:#333; text-decoration:none; font-weight:600; padding:.5rem 1rem; border-radius:.5rem; transition:all .2s; }
        .nav-links a:hover { background:#667eea; color:#fff; }
        
        .product-detail {
            background: rgba(255,255,255,0.98);
            border-radius: 1rem;
            padding: 3rem;
            box-shadow: 0 8px 30px rgba(0,0,0,0.1);
        }
        .breadcrumb {
            margin-bottom: 2rem;
            color: #666;
        }
        .breadcrumb a {
            color: #667eea;
            text-decoration: none;
        }
        .product-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
        }
        .product-image-section {
            position: relative;
        }
        .main-image {
            width: 100%;
            border-radius: 1rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: #ef4444;
            color: #fff;
            padding: .5rem 1rem;
            border-radius: 2rem;
            font-weight: 700;
        }
        .product-info-section h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: #333;
        }
        .rating {
            color: #fbbf24;
            font-size: 1.2rem;
            margin-bottom: 1rem;
        }
        .price {
            font-size: 3rem;
            font-weight: 900;
            color: #667eea;
            margin: 1rem 0;
        }
        .stock-info {
            padding: 1rem;
            background: #f0fdf4;
            border-left: 4px solid #10b981;
            margin: 1rem 0;
            border-radius: .5rem;
        }
        .description {
            margin: 2rem 0;
            line-height: 1.8;
            color: #555;
        }
        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 2rem 0;
        }
        .qty-controls {
            display: flex;
            border: 2px solid #e2e8f0;
            border-radius: .5rem;
        }
        .qty-btn {
            padding: 1rem 1.5rem;
            border: none;
            background: #f8fafc;
            cursor: pointer;
            font-weight: 700;
            font-size: 1.2rem;
        }
        .qty-display {
            padding: 1rem 2rem;
            font-weight: 700;
            font-size: 1.2rem;
        }
        .action-buttons {
            display: flex;
            gap: 1rem;
        }
        .btn-primary {
            flex: 1;
            padding: 1.2rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border: none;
            border-radius: .7rem;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all .3s;
        }
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(102,126,234,.4);
        }
        .btn-secondary {
            padding: 1.2rem 2rem;
            background: #fff;
            border: 2px solid #667eea;
            color: #667eea;
            border-radius: .7rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            transition: all .3s;
        }
        .features-list {
            margin: 2rem 0;
        }
        .feature-item {
            padding: 1rem;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        @media (max-width: 768px) {
            .product-layout { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">🛒 FreshMarket</div>
                <div class="nav-links">
                    <a href="/">Home</a>
                    <a href="/shopping">Shop</a>
                    <a href="/cart">Cart</a>
                    <a href="/logout">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="product-detail">
            <div class="breadcrumb">
                <a href="/">Home</a> / <a href="/shopping">Shop</a> / <%= product.productName %>
            </div>

            <div class="product-layout">
                <div class="product-image-section">
                    <div class="badge">⭐ Popular</div>
                    <img src="/images/<%= product.image %>" alt="<%= product.productName %>" class="main-image">
                </div>

                <div class="product-info-section">
                    <h1><%= product.productName %></h1>
                    <div class="rating">
                        ⭐⭐⭐⭐⭐ <span style="color:#666">(128 reviews)</span>
                    </div>
                    <div class="price">$<%= product.price.toFixed(2) %></div>

                    <div class="stock-info">
                        <% if (product.quantity > 10) { %>
                            ✅ <strong>In Stock</strong> - Ready to ship
                        <% } else if (product.quantity > 0) { %>
                            ⚠️ <strong>Low Stock</strong> - Only <%= product.quantity %> left
                        <% } else { %>
                            ❌ <strong>Out of Stock</strong>
                        <% } %>
                    </div>

                    <div class="description">
                        <h3>Product Description</h3>
                        <p>Fresh, high-quality <%= product.productName %> sourced from local farms. Perfect for your daily needs with guaranteed freshness and best prices.</p>
                    </div>

                    <div class="features-list">
                        <div class="feature-item">🚚 Free delivery on orders over $50</div>
                        <div class="feature-item">✅ 100% Quality guarantee</div>
                        <div class="feature-item">🔄 Easy 7-day returns</div>
                        <div class="feature-item">❄️ Fresh from farm to table</div>
                    </div>

                    <form action="/add-to-cart/<%= product.id %>" method="POST">
                        <div class="quantity-selector">
                            <label style="font-weight:700">Quantity:</label>
                            <div class="qty-controls">
                                <button type="button" class="qty-btn" onclick="decreaseQty()">−</button>
                                <input type="number" id="qtyInput" name="quantity" value="1" min="1" max="<%= product.quantity %>" class="qty-display" readonly>
                                <button type="button" class="qty-btn" onclick="increaseQty()">+</button>
                            </div>
                        </div>

                        <div class="action-buttons">
                            <button type="submit" class="btn-primary" <%= product.quantity === 0 ? 'disabled' : '' %>>
                                🛒 Add to Cart
                            </button>
                            <a href="/shopping" class="btn-secondary">← Back to Shop</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Add Review Section (before closing container) -->
            <div style="margin-top:3rem;">
                <h2 style="color:#333;margin-bottom:1.5rem;">⭐ Customer Reviews</h2>
                
                <!-- Add Review Form -->
                <div style="background:#f8fafc;padding:2rem;border-radius:1rem;margin-bottom:2rem;">
                    <h3 style="margin-bottom:1rem;">Write a Review</h3>
                    <form action="/product/<%= product.id %>/review" method="POST">
                        <div style="margin-bottom:1rem;">
                            <label style="display:block;margin-bottom:.5rem;font-weight:600;">Rating:</label>
                            <div style="display:flex;gap:.5rem;">
                                <% for(let i=1; i<=5; i++) { %>
                                    <label style="cursor:pointer;">
                                        <input type="radio" name="rating" value="<%= i %>" required style="display:none;">
                                        <span class="star" data-rating="<%= i %>" style="font-size:2rem;color:#ddd;">★</span>
                                    </label>
                                <% } %>
                            </div>
                        </div>
                        
                        <div style="margin-bottom:1rem;">
                            <label style="display:block;margin-bottom:.5rem;font-weight:600;">Your Review:</label>
                            <textarea name="review_text" rows="4" style="width:100%;padding:1rem;border:2px solid #e2e8f0;border-radius:.5rem;font-family:inherit;" placeholder="Share your experience with this product..."></textarea>
                        </div>
                        
                        <button type="submit" style="padding:1rem 2rem;background:#667eea;color:#fff;border:none;border-radius:.7rem;font-weight:700;cursor:pointer;">Submit Review</button>
                    </form>
                </div>

                <!-- Display Reviews -->
                <div>
                    <% if (reviews && reviews.length > 0) { %>
                        <% reviews.forEach(review => { %>
                            <div style="background:#fff;padding:1.5rem;border-radius:1rem;margin-bottom:1rem;box-shadow:0 2px 10px rgba(0,0,0,.05);">
                                <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;">
                                    <strong style="color:#333;"><%= review.username %></strong>
                                    <span style="color:#f59e0b;font-size:1.2rem;">
                                        <% for(let i=0; i<review.rating; i++) { %>★<% } %>
                                        <% for(let i=review.rating; i<5; i++) { %>☆<% } %>
                                    </span>
                                </div>
                                <p style="color:#666;margin-bottom:.5rem;"><%= review.review_text || 'No comment' %></p>
                                <small style="color:#999;"><%= new Date(review.created_at).toLocaleDateString() %></small>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p style="text-align:center;color:#999;padding:2rem;">No reviews yet. Be the first to review!</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        const maxQty = <%= product.quantity %>;
        
        function increaseQty() {
            const input = document.getElementById('qtyInput');
            if (parseInt(input.value) < maxQty) {
                input.value = parseInt(input.value) + 1;
            }
        }
        
        function decreaseQty() {
            const input = document.getElementById('qtyInput');
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }

        // Star rating interaction
        const stars = document.querySelectorAll('.star');
        const radios = document.querySelectorAll('input[name="rating"]');
        
        stars.forEach(star => {
            star.addEventListener('click', function() {
                const rating = parseInt(this.dataset.rating);
                radios[rating-1].checked = true;
                updateStars(rating);
            });
            
            star.addEventListener('mouseenter', function() {
                const rating = parseInt(this.dataset.rating);
                updateStars(rating);
            });
        });
        
        document.querySelector('form').addEventListener('mouseleave', function() {
            const checkedRadio = document.querySelector('input[name="rating"]:checked');
            if (checkedRadio) {
                updateStars(parseInt(checkedRadio.value));
            } else {
                updateStars(0);
            }
        });
        
        function updateStars(rating) {
            stars.forEach((star, index) => {
                if (index < rating) {
                    star.style.color = '#f59e0b';
                } else {
                    star.style.color = '#ddd';
                }
            });
        }
    </script>
</body>
</html>
