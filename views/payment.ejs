<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment - FreshMarket</title>
    <link rel="stylesheet" href="/css/themes.css?v=1">
    <link rel="stylesheet" href="/css/payment.css?v=1">
    <script src="https://www.paypal.com/sdk/js?client-id=<%= (process.env.PAYPAL_CLIENT_ID && process.env.PAYPAL_CLIENT_ID !== 'your_paypal_client_id') ? process.env.PAYPAL_CLIENT_ID : 'sb' %>&currency=SGD"></script>
</head>
<body class="<%= user && user.role === 'admin' ? 'admin-theme' : 'user-theme' %>">
    <div class="payment-page">
        <header class="payment-header">
            <div class="brand">FreshMarket</div>
            <div class="steps">
                <div class="step active">1. Cart</div>
                <div class="step active">2. Details</div>
                <div class="step">3. Payment</div>
            </div>
            <a class="back-link" href="/cart">Back to cart</a>
        </header>

        <div class="payment-grid" id="paymentOrchestratorApp" data-order-id="">
            <section class="panel left">
                <div class="section-title">Order Summary</div>
                <div class="card summary-card">
                    <% if (cart && cart.length > 0) { %>
                        <div class="summary-list">
                            <% cart.forEach(item => { %>
                                <div class="summary-row">
                                    <div>
                                        <div class="summary-name"><%= item.name %></div>
                                        <div class="summary-meta">Qty: <%= item.quantity %></div>
                                    </div>
                                    <div class="summary-amount">$<%= (item.price * item.quantity).toFixed(2) %></div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="muted">No items in cart.</div>
                    <% } %>
                    <div class="summary-total">
                        <span>Total</span>
                        <strong>$<%= (total || 0).toFixed(2) %></strong>
                    </div>
                </div>

                <div class="section-title">Wallet</div>
                <div class="card wallet-card">
                    <div class="wallet-balance">
                        <span class="muted">Balance</span>
                        <div class="wallet-amount" id="walletBalance">$0.00</div>
                    </div>
                    <div class="input-row">
                        <label for="walletUse">Use wallet amount</label>
                        <input id="walletUse" type="number" min="0" step="0.01" placeholder="0.00">
                    </div>
                    <div class="wallet-actions">
                        <button type="button" class="btn ghost-btn" id="walletApplyBtn">Apply</button>
                    </div>
                    <div class="input-row">
                        <label for="walletTopup">Top up wallet</label>
                        <input id="walletTopup" type="number" min="0" step="0.01" placeholder="10.00">
                    </div>
                    <button type="button" class="btn primary-btn" id="walletTopupBtn">Top up</button>
                </div>
            </section>

            <section class="panel right">
                <div class="section-title">Payment Methods</div>
                <div class="method-list">
                    <div class="method-card" data-provider="PAYPAL">
                        <div class="method-info">
                            <div class="method-icon">P</div>
                            <div>
                                <div class="method-title">PayPal</div>
                                <div class="method-note">Secure checkout with PayPal.</div>
                            </div>
                        </div>
                        <div class="method-action">
                            <div id="paypal-button-container"></div>
                            <div id="paypal-error" class="error-text" style="display:none;">PayPal failed to load. Check PAYPAL_CLIENT_ID.</div>
                        </div>
                    </div>

                    <div class="method-card" data-provider="NETS">
                        <div class="method-info">
                            <div class="method-icon">N</div>
                            <div>
                                <div class="method-title">NETS QR</div>
                                <div class="method-note">Pay by scanning a NETS QR code.</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="netsBtn">Pay with NETS</button>
                    </div>

                    <div class="method-card" data-provider="STRIPE">
                        <div class="method-info">
                            <div class="method-icon">S</div>
                            <div>
                                <div class="method-title">Stripe</div>
                                <div class="method-note">Pay securely with Stripe Checkout.</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="stripeBtn">Pay with Stripe</button>
                    </div>

                    <div class="method-card" data-provider="STRIPE_PAYNOW">
                        <div class="method-info">
                            <div class="method-icon">PN</div>
                            <div>
                                <div class="method-title">PayNow (Stripe)</div>
                                <div class="method-note">Stripe PayNow test mode.</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="stripePaynowBtn">PayNow</button>
                    </div>

                    <div class="method-card" data-provider="AIRWALLEX">
                        <div class="method-info">
                            <div class="method-icon">A</div>
                            <div>
                                <div class="method-title">Airwallex</div>
                                <div class="method-note">Airwallex hosted checkout (sandbox).</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="airwallexBtn">Pay with Airwallex</button>
                    </div>
                </div>

                <div class="status-card">
                    <div class="status-title">Payment Status</div>
                    <div class="fine-print" id="statusArea">Status: Ready.</div>
                    <div id="airwallexQrWrap" style="display:none; margin-top:1rem;">
                        <div class="method-note">Scan the QR with your banking app.</div>
                        <img id="airwallexQrImg" alt="Airwallex QR" />
                    </div>
                </div>
            </section>
        </div>
    </div>

    <script>
        async function fetchWalletBalance() {
            const res = await fetch('/api/payments/wallet/balance');
            const data = await res.json();
            if (data && data.balance !== undefined) {
                document.getElementById('walletBalance').textContent = `$${Number(data.balance).toFixed(2)}`;
            }
        }
        fetchWalletBalance();

        async function createPayment(provider) {
            let walletUse = parseFloat(document.getElementById('walletUse').value || '0');
            if (Number.isNaN(walletUse)) {
                walletUse = 0;
            }
            const res = await fetch('/api/payments/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ provider, useWalletAmount: walletUse })
            });
            const data = await res.json();
            if (!res.ok && data && data.error) {
                console.warn('Payment create error:', data.error);
            }
            return data;
        }
        try {
            if (!window.paypal || !paypal.Buttons) {
                document.getElementById('paypal-error').style.display = 'block';
            } else {
                const paypalButtons = paypal.Buttons({
                    createOrder: function () {
                        return fetch('/api/paypal/create-order', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({})
                        })
                        .then((res) => res.json())
                        .then((data) => data.id);
                    },
                    onApprove: function (data) {
                        return fetch('/api/paypal/capture-order', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ orderID: data.orderID })
                        })
                        .then((res) => res.json())
                        .then((result) => {
                            if (result && result.success && result.orderId) {
                                window.location.href = '/checkout/success/' + result.orderId;
                            } else {
                                alert('Payment not completed.');
                            }
                        });
                    },
                    onError: function () {
                        alert('PayPal payment failed. Please try again.');
                    }
                });

                if (!paypalButtons) {
                    document.getElementById('paypal-error').style.display = 'block';
                } else {
                    paypalButtons.render('#paypal-button-container');
                }
            }
        } catch (err) {
            console.error('PayPal render failed:', err);
            document.getElementById('paypal-error').style.display = 'block';
        }

        async function topupWallet() {
            const amount = parseFloat(document.getElementById('walletTopup').value || '0');
            if (!amount || amount <= 0) {
                document.getElementById('statusArea').textContent = 'Status: Enter a valid topup amount.';
                return;
            }
            const res = await fetch('/api/payments/wallet/topup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount })
            });
            const data = await res.json();
            if (data && data.balance !== undefined) {
                document.getElementById('walletBalance').textContent = `$${Number(data.balance).toFixed(2)}`;
                document.getElementById('statusArea').textContent = 'Status: Wallet topped up.';
            }
        }

        document.getElementById('walletTopupBtn').addEventListener('click', topupWallet);
        document.getElementById('walletApplyBtn').addEventListener('click', () => {
            document.getElementById('statusArea').textContent = 'Status: Wallet amount will be applied.';
        });

        document.getElementById('netsBtn').addEventListener('click', async () => {
            selectedProvider = 'NETS';
            document.getElementById('statusArea').textContent = 'Status: Redirecting to NETS QR...';
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/api/nets/generate-qr';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'cartTotal';
            input.value = '<%= (total || 0).toFixed(2) %>';
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        });

        document.getElementById('stripeBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to Stripe...';
            const data = await createPayment('STRIPE');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
            } else {
                document.getElementById('statusArea').textContent = 'Status: Stripe unavailable.';
            }
        });

        document.getElementById('stripePaynowBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to PayNow...';
            const data = await createPayment('STRIPE_PAYNOW');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
            } else {
                document.getElementById('statusArea').textContent = 'Status: PayNow unavailable.';
            }
        });

        document.getElementById('airwallexBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to Airwallex checkout...';
            const data = await createPayment('AIRWALLEX');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
                return;
            }
            if (data && data.providerData && data.providerData.qrCode) {
                const qrWrap = document.getElementById('airwallexQrWrap');
                const qrImg = document.getElementById('airwallexQrImg');
                qrImg.src = data.providerData.qrCode;
                qrWrap.style.display = 'block';
                document.getElementById('statusArea').textContent = 'Status: Scan the Airwallex QR code to complete payment.';
                return;
            }
            document.getElementById('statusArea').textContent = 'Status: Airwallex unavailable.';
        });
    </script>
</body>
</html>
