<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment - FreshMarket</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/themes.css?v=1">
    <link rel="stylesheet" href="/css/payment.css?v=1">
    <link rel="stylesheet" href="/css/payment_tidy.css?v=1">
    <script src="https://www.paypal.com/sdk/js?client-id=<%= (process.env.PAYPAL_CLIENT_ID && process.env.PAYPAL_CLIENT_ID !== 'your_paypal_client_id') ? process.env.PAYPAL_CLIENT_ID : 'sb' %>&currency=SGD"></script>
    <style>
        :root {
            --ink: #121417;
            --muted: #5f6b7a;
            --cream: #f9f5ef;
            --sun: #f4c04f;
            --mint: #b6e2d3;
            --leaf: #215246;
            --card: #ffffff;
            --shadow: 0 18px 50px rgba(18, 20, 23, 0.12);
        }

        body.user-theme {
            font-family: "Space Grotesk", system-ui, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at 8% 8%, rgba(244, 192, 79, 0.25), transparent 45%),
                radial-gradient(circle at 92% 12%, rgba(182, 226, 211, 0.35), transparent 40%),
                linear-gradient(180deg, #fff 0%, var(--cream) 50%, #fff 100%);
        }

        .payment-page {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2.5rem 1.5rem 3.5rem;
        }

        .payment-header .brand {
            font-family: "Fraunces", serif;
            font-size: 1.9rem;
            color: var(--leaf);
        }

        .payment-header .steps .step {
            border-radius: 999px;
            padding: 0.35rem 0.9rem;
            background: rgba(33, 82, 70, 0.08);
            color: var(--leaf);
        }

        .payment-grid {
            gap: 1.75rem;
        }

        .panel {
            background: var(--card);
            border-radius: 22px;
            box-shadow: var(--shadow);
            padding: 1.5rem;
            align-content: start;
        }

        .section-title {
            font-weight: 700;
            color: var(--leaf);
            letter-spacing: 0.02em;
        }

        .card {
            border-radius: 18px;
            border: 1px solid rgba(18, 20, 23, 0.06);
            box-shadow: none;
            background: #fff;
        }

        .wallet-card {
            background: linear-gradient(135deg, rgba(244, 192, 79, 0.12), rgba(182, 226, 211, 0.18));
        }

        .method-card {
            border-radius: 16px;
            border: 1px solid rgba(18, 20, 23, 0.08);
            background: #fff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .method-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(18, 20, 23, 0.1);
        }

        .method-icon {
            background: var(--leaf);
            color: #fff;
            border-radius: 12px;
            font-weight: 700;
        }

        .btn.primary-btn,
        .btn.primary {
            background: var(--leaf);
            border-color: var(--leaf);
            color: #fff;
        }

        .btn.ghost-btn {
            border-color: rgba(18, 20, 23, 0.15);
            color: var(--leaf);
        }

        .status-card {
            background: #fffdf8;
            border: 1px dashed rgba(33, 82, 70, 0.35);
        }

        .fine-print,
        .muted {
            color: var(--muted);
        }

        .summary-card {
            padding: 0.8rem;
        }

        .summary-list {
            gap: 0.35rem;
        }

        .summary-row {
            padding: 0.2rem 0;
        }

        .summary-total {
            padding-top: 0.4rem;
            margin-top: 0.4rem;
        }

        .wallet-card .input-row,
        .card .input-row {
            margin-bottom: 0.6rem;
        }

        .wallet-card .btn,
        .card .btn {
            padding: 0.45rem 0.8rem;
        }

        .wallet-reward-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.6rem;
            padding-top: 0.6rem;
            border-top: 1px dashed rgba(33, 82, 70, 0.25);
            color: var(--leaf);
            font-weight: 700;
        }

        @media (max-width: 980px) {
            .payment-page {
                padding: 1.5rem 1rem 3rem;
            }
        }
    </style>
</head>
<body class="<%= user && user.role === 'admin' ? 'admin-theme' : 'user-theme' %>">
    <div class="payment-page">
        <header class="payment-header">
            <div class="brand">FreshMarket</div>
            <div class="steps">
                <div class="step active">1. Cart</div>
                <div class="step active">2. Details</div>
                <div class="step">3. Payment</div>
            </div>
            <a class="back-link" href="/cart">Back to cart</a>
        </header>

        <div class="payment-grid" id="paymentOrchestratorApp" data-order-id="">
            <section class="panel left">
                <div class="section-title">Order Summary</div>
                <div class="card summary-card">
                    <% if (cart && cart.length > 0) { %>
                        <div class="summary-list">
                            <% cart.forEach(item => { %>
                                <div class="summary-row">
                                    <div>
                                        <div class="summary-name"><%= item.name %></div>
                                        <div class="summary-meta">Qty: <%= item.quantity %></div>
                                    </div>
                                    <div class="summary-amount">$<%= (item.price * item.quantity).toFixed(2) %></div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="muted">No items in cart.</div>
                    <% } %>
                    <div class="summary-total">
                        <span>Total</span>
                        <strong>$<%= (total || 0).toFixed(2) %></strong>
                    </div>
                </div>

                <div class="section-title">Wallet</div>
                <div class="card wallet-card">
                    <div class="wallet-balance">
                        <span class="muted">Balance</span>
                        <div class="wallet-amount" id="walletBalance">$0.00</div>
                    </div>
                    <div class="input-row">
                        <label for="walletUse">Use wallet amount</label>
                        <input id="walletUse" type="number" min="0" step="0.01" placeholder="0.00">
                    </div>
                    <div class="wallet-actions">
                        <button type="button" class="btn ghost-btn" id="walletApplyBtn">Apply</button>
                    </div>
                    <div class="wallet-reward-row" id="walletRewardRow" style="display:none;">
                        <span class="muted">Freshcoins earned</span>
                        <strong id="walletRewardAmount">+$0.00</strong>
                    </div>
                </div>
            </section>

            <section class="panel right">
                <div class="section-title">Payment Methods</div>
                <div class="method-list">
                    <div class="method-card" data-provider="WALLET">
                        <div class="method-info">
                            <div class="method-icon">W</div>
                            <div>
                                <div class="method-title">E-Wallet</div>
                                <div class="method-note">Pay instantly with your wallet balance.</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="walletPayBtn">Pay with Wallet</button>
                    </div>

                    <div class="method-card" data-provider="PAYPAL">
                        <div class="method-info">
                            <div class="method-icon">P</div>
                            <div>
                                <div class="method-title">PayPal</div>
                                <div class="method-note">Secure checkout with PayPal.</div>
                            </div>
                        </div>
                        <div class="method-action">
                            <div id="paypal-button-container"></div>
                            <div id="paypal-error" class="error-text" style="display:none;">PayPal failed to load. Check PAYPAL_CLIENT_ID.</div>
                        </div>
                    </div>

                    <div class="method-card" data-provider="NETS">
                        <div class="method-info">
                            <div class="method-icon">N</div>
                            <div>
                                <div class="method-title">NETS QR</div>
                                <div class="method-note">Pay by scanning a NETS QR code.</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="netsBtn">Pay with NETS</button>
                    </div>

                    <div class="method-card" data-provider="STRIPE">
                        <div class="method-info">
                            <div class="method-icon">S</div>
                            <div>
                                <div class="method-title">Stripe</div>
                                <div class="method-note">Pay securely with Stripe Checkout.</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="stripeBtn">Pay with Stripe</button>
                    </div>

                    <div class="method-card" data-provider="STRIPE_PAYNOW">
                        <div class="method-info">
                            <div class="method-icon">PN</div>
                            <div>
                                <div class="method-title">PayNow (Stripe)</div>
                                <div class="method-note">Stripe PayNow test mode.</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="stripePaynowBtn">PayNow</button>
                    </div>

                    <div class="method-card" data-provider="AIRWALLEX">
                        <div class="method-info">
                            <div class="method-icon">A</div>
                            <div>
                                <div class="method-title">Airwallex</div>
                                <div class="method-note">Airwallex hosted checkout (sandbox).</div>
                            </div>
                        </div>
                        <button type="button" class="btn ghost-btn" id="airwallexBtn">Pay with Airwallex</button>
                    </div>
                </div>

                <div class="status-card">
                    <div class="status-title">Payment Status</div>
                    <div class="fine-print" id="statusArea">Status: Ready.</div>
                    <div id="airwallexQrWrap" style="display:none; margin-top:1rem;">
                        <div class="method-note">Scan the QR with your banking app.</div>
                        <img id="airwallexQrImg" alt="Airwallex QR" />
                    </div>
                </div>
            </section>
        </div>
    </div>

    <script>
        async function fetchWalletBalance() {
            const res = await fetch('/api/payments/wallet/balance');
            const data = await res.json();
            if (data && data.balance !== undefined) {
                const balance = Number(data.balance);
                document.getElementById('walletBalance').textContent = `$${balance.toFixed(2)}`;
                window.__walletBalance = balance;
            }
            try {
                const reward = JSON.parse(localStorage.getItem('freshcoinReward') || 'null');
                if (reward && reward.amount) {
                    const row = document.getElementById('walletRewardRow');
                    const amt = document.getElementById('walletRewardAmount');
                    if (row && amt) {
                        amt.textContent = `+$${Number(reward.amount).toFixed(2)}`;
                        row.style.display = 'flex';
                    }
                }
            } catch (err) {
                // ignore
            }
        }
        fetchWalletBalance();


        function generateIdempotencyKey() {
            if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
            return 'idem-' + Date.now() + '-' + Math.random().toString(16).slice(2);
        }

        function setStatus(message) {
            const statusEl = document.getElementById('statusArea');
            if (statusEl) statusEl.textContent = `Status: ${message}`;
        }

        function explainWalletUsage(data) {
            if (!data) return;
            const applied = Number(data.walletApplied || 0);
            const shortfall = Number(data.walletShortfall || 0);
            const remaining = Number(data.remaining || 0);
            if (applied > 0 && remaining > 0) {
                setStatus(`Wallet applied $${applied.toFixed(2)}. Remaining $${remaining.toFixed(2)}.`);
            } else if (applied > 0 && remaining <= 0) {
                setStatus(`Wallet paid $${applied.toFixed(2)}. Order complete.`);
            } else if (shortfall > 0) {
                setStatus(`Wallet balance is too low by $${shortfall.toFixed(2)}. Choose another method.`);
            }
        }

        const orderTotal = parseFloat('<%= (total || 0).toFixed(2) %>');

        async function createPayment(provider) {
            let walletUse = parseFloat(document.getElementById('walletUse').value || '0');
            if (Number.isNaN(walletUse)) {
                walletUse = 0;
            }
            const res = await fetch('/api/payments/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Idempotency-Key': generateIdempotencyKey() },
                body: JSON.stringify({ provider, useWalletAmount: walletUse })
            });
            const data = await res.json();
            if (!res.ok && data && data.error) {
                setStatus(data.error);
                console.warn('Payment create error:', data.error);
            }
            explainWalletUsage(data);
            return data;
        }

        document.getElementById('walletPayBtn').addEventListener('click', async () => {
            const balance = Number(window.__walletBalance || 0);
            if (balance < orderTotal) {
                setStatus(`Wallet has $${balance.toFixed(2)}. You need $${(orderTotal - balance).toFixed(2)} more.`);
                return;
            }
            document.getElementById('walletUse').value = orderTotal.toFixed(2);
            const data = await createPayment('PAYPAL');
            if (data && data.remaining <= 0 && data.orderId) {
                setStatus('Wallet covered the full amount. Redirecting...');
                window.location.href = '/checkout/success/' + data.orderId;
            }
        });
        try {
            if (!window.paypal || !paypal.Buttons) {
                document.getElementById('paypal-error').style.display = 'block';
            } else {
                const paypalButtons = paypal.Buttons({
                    createOrder: function () {
                        return createPayment('PAYPAL')
                            .then((data) => {
                                if (!data || data.error) {
                                    throw new Error(data && data.error ? data.error : 'Payment creation failed');
                                }
                                if (Number(data.remaining || 0) <= 0) {
                                    setStatus('Wallet covered the full amount. Redirecting...');
                                    window.location.href = '/checkout/success/' + data.orderId;
                                    throw new Error('WALLET_PAID');
                                }
                                if (!data.providerData || !data.providerData.providerRef) {
                                    throw new Error('PayPal unavailable.');
                                }
                                return data.providerData.providerRef;
                            });
                    },
                    onApprove: function (data) {
                        return fetch('/api/payments/callback/paypal', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ providerRef: data.orderID })
                        })
                        .then((res) => res.json())
                        .then((result) => {
                            if (result && result.success && result.orderId) {
                                window.location.href = '/checkout/success/' + result.orderId;
                            } else {
                                setStatus('Payment not completed.');
                            }
                        });
                    },
                    onError: function (err) {
                        if (err && err.message === 'WALLET_PAID') return;
                        setStatus('PayPal payment failed. Please try again.');
                    }
                });

                if (!paypalButtons) {
                    document.getElementById('paypal-error').style.display = 'block';
                } else {
                    paypalButtons.render('#paypal-button-container');
                }
            }
        } catch (err) {
            console.error('PayPal render failed:', err);
            document.getElementById('paypal-error').style.display = 'block';
        }

        document.getElementById('walletApplyBtn').addEventListener('click', () => {
            const walletUse = parseFloat(document.getElementById('walletUse').value || '0');
            const balance = Number(window.__walletBalance || 0);
            if (!walletUse || walletUse <= 0) {
                setStatus('Enter a wallet amount to apply.');
                return;
            }
            if (walletUse > balance) {
                setStatus(`Wallet has $${balance.toFixed(2)}. We will apply that amount.`);
            } else {
                setStatus(`Wallet amount $${walletUse.toFixed(2)} will be applied.`);
            }
        });

        document.getElementById('netsBtn').addEventListener('click', async () => {
            selectedProvider = 'NETS';
            document.getElementById('statusArea').textContent = 'Status: Redirecting to NETS QR...';
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/api/nets/generate-qr';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'cartTotal';
            input.value = '<%= (total || 0).toFixed(2) %>';
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        });

        document.getElementById('stripeBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to Stripe...';
            const data = await createPayment('STRIPE');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
            } else {
                document.getElementById('statusArea').textContent = 'Status: Stripe unavailable.';
            }
        });

        document.getElementById('stripePaynowBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to PayNow...';
            const data = await createPayment('STRIPE_PAYNOW');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
            } else {
                document.getElementById('statusArea').textContent = 'Status: PayNow unavailable.';
            }
        });

        document.getElementById('airwallexBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to Airwallex checkout...';
            const data = await createPayment('AIRWALLEX');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
                return;
            }
            if (data && data.providerData && data.providerData.qrCode) {
                const qrWrap = document.getElementById('airwallexQrWrap');
                const qrImg = document.getElementById('airwallexQrImg');
                qrImg.src = data.providerData.qrCode;
                qrWrap.style.display = 'block';
                document.getElementById('statusArea').textContent = 'Status: Scan the Airwallex QR code to complete payment.';
                return;
            }
            document.getElementById('statusArea').textContent = 'Status: Airwallex unavailable.';
        });
    </script>
</body>
</html>
