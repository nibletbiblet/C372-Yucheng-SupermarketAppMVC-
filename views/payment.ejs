<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment - FreshMarket</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

        :root {
            --bg: #0e1013;
            --bg-2: #12161c;
            --panel: #161b22;
            --panel-2: #1b2230;
            --card: #0f1319;
            --card-2: #141a22;
            --text: #e7ecf4;
            --muted: #9aa4b2;
            --line: #262d38;
            --blue: #2f6bff;
            --green: #24d19d;
            --glow: rgba(47, 107, 255, 0.35);
        }

        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Manrope', system-ui, -apple-system, Segoe UI, sans-serif;
            background: radial-gradient(1200px 600px at 10% -10%, rgba(47, 107, 255, 0.25), transparent 60%),
                        radial-gradient(1000px 500px at 90% -10%, rgba(36, 209, 157, 0.2), transparent 60%),
                        linear-gradient(180deg, var(--bg), var(--bg-2));
            color: var(--text);
            min-height: 100vh;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(800px 400px at 80% 20%, rgba(255, 255, 255, 0.03), transparent 70%),
                radial-gradient(600px 300px at 20% 80%, rgba(255, 255, 255, 0.02), transparent 70%);
            pointer-events: none;
        }

        .shell {
            width: 92%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 2.5rem 0 3rem;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2.5rem;
        }

        .brand {
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .steps {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            font-size: 0.85rem;
            color: var(--muted);
        }

        .step {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            border: 2px solid var(--line);
        }

        .dot.active {
            border-color: var(--green);
            background: var(--green);
            box-shadow: 0 0 0 5px rgba(36, 209, 157, 0.15);
        }

        .payment-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .panel {
            background: linear-gradient(145deg, var(--panel), var(--panel-2));
            border: 1px solid var(--line);
            border-radius: 22px;
            padding: 2rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
            position: relative;
            overflow: hidden;
            animation: rise 0.6s ease forwards;
        }

        .panel::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(400px 200px at 10% 0%, rgba(255, 255, 255, 0.04), transparent 70%);
            pointer-events: none;
        }

        .left h1 {
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: 1.4rem;
            margin: 0.75rem 0 1.5rem;
        }

        .back-link {
            color: var(--muted);
            text-decoration: none;
            font-size: 0.9rem;
        }

        .back-link:hover { color: var(--text); }

        .method-list {
            display: grid;
            gap: 0.9rem;
            margin-bottom: 1.5rem;
        }

        .method-card {
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 1rem 1.1rem;
            background: linear-gradient(145deg, var(--card), var(--card-2));
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            transition: all 0.2s ease;
        }

        .method-card:hover {
            transform: translateY(-2px);
            border-color: rgba(47, 107, 255, 0.6);
            box-shadow: 0 12px 30px rgba(47, 107, 255, 0.15);
        }

        .method-info {
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .method-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #111721;
            display: grid;
            place-items: center;
            font-weight: 700;
            color: var(--blue);
        }

        .method-title { font-weight: 600; }
        .method-note { color: var(--muted); font-size: 0.85rem; }

        .amount-card {
            border-radius: 18px;
            padding: 1.5rem;
            background: linear-gradient(145deg, #171d27, #10141b);
            border: 1px solid var(--line);
            margin-bottom: 1.25rem;
        }

        .amount-label { color: var(--muted); font-size: 0.85rem; }
        .amount-value {
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: 2.2rem;
            margin: 0.4rem 0 1rem;
            letter-spacing: 0.5px;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #c7f7e7;
            font-size: 0.85rem;
        }

        .tag span {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: var(--green);
        }

        .plan-card {
            margin-top: 1.25rem;
            background: #0f141c;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .plan-title { font-weight: 600; font-size: 0.95rem; }
        .plan-desc { color: var(--muted); font-size: 0.8rem; margin-top: 0.3rem; }

        .ghost-btn {
            border: 1px solid var(--line);
            background: #151b24;
            color: var(--text);
            padding: 0.7rem 1.1rem;
            border-radius: 10px;
            font-size: 0.85rem;
            min-width: 170px;
            min-height: 42px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        }
        .ghost-btn:hover {
            border-color: rgba(47, 107, 255, 0.7);
            box-shadow: 0 10px 22px rgba(47, 107, 255, 0.18);
            transform: translateY(-1px);
        }
        .ghost-btn:active {
            transform: translateY(0);
            box-shadow: none;
        }

        .right h2 {
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: 2rem;
        }

        .right p { color: var(--muted); margin: 0.4rem 0 1.5rem; }

        .form-grid {
            display: grid;
            gap: 1rem;
        }

        .input-group { display: grid; gap: 0.4rem; }
        label { font-size: 0.8rem; color: var(--muted); }
        input {
            background: #0f141c;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 0.9rem 1rem;
            color: var(--text);
            font-size: 0.95rem;
            transition: border 0.2s ease;
        }

        input:focus {
            outline: none;
            border-color: rgba(47, 107, 255, 0.6);
            box-shadow: 0 0 0 3px rgba(47, 107, 255, 0.2);
        }

        .split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .apply-row {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 0.75rem;
            align-items: end;
        }

        .apply-btn {
            background: #1c2230;
            border: 1px solid var(--line);
            color: var(--text);
            padding: 0.85rem 1.2rem;
            border-radius: 12px;
            cursor: pointer;
        }

        .primary-btn {
            margin-top: 1rem;
            background: linear-gradient(135deg, #2f6bff, #0d3ccf);
            color: #fff;
            padding: 1rem;
            border: none;
            border-radius: 14px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 18px 35px var(--glow);
        }

        .primary-btn:hover {
            transform: translateY(-1px);
        }

        .fine-print {
            margin-top: 1.25rem;
            color: #7d8796;
            font-size: 0.75rem;
        }

        #paypal-button-container {
            min-height: 46px;
        }

        #paypal-error {
            margin-top: 0.5rem;
            color: #ffb4b4;
            font-size: 0.8rem;
        }

        @keyframes rise {
            from { transform: translateY(12px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        @media (max-width: 980px) {
            .payment-grid { grid-template-columns: 1fr; }
            .topbar { flex-direction: column; align-items: flex-start; gap: 1rem; }
        }

        @media (max-width: 600px) {
            .split { grid-template-columns: 1fr; }
            .apply-row { grid-template-columns: 1fr; }
        }
    </style>
    <script src="https://www.paypal.com/sdk/js?client-id=<%= (process.env.PAYPAL_CLIENT_ID && process.env.PAYPAL_CLIENT_ID !== 'your_paypal_client_id') ? process.env.PAYPAL_CLIENT_ID : 'sb' %>&currency=SGD"></script>
</head>
<body>
    <div class="shell">
        <header class="topbar">
            <div class="brand">FreshMarket</div>
            <div class="steps">
                <div class="step"><span class="dot active"></span> Select Plan</div>
                <div class="step"><span class="dot active"></span> Information</div>
                <div class="step"><span class="dot"></span> Final Payment</div>
            </div>
        </header>

        <div class="payment-grid" id="paymentOrchestratorApp" data-order-id="">
            <section class="panel left">
                <div class="amount-card" style="margin-bottom:1.25rem;">
                    <div class="amount-label">Wallet balance</div>
                    <div class="amount-value" id="walletBalance">$0.00</div>
                    <div class="method-note">Use wallet to split your payment.</div>
                    <div class="input-group" style="margin-top:0.75rem;">
                        <label for="walletUse">Use wallet amount</label>
                        <input id="walletUse" type="number" min="0" step="0.01" placeholder="0.00">
                    </div>
                    <div class="apply-row" style="margin-top:0.75rem;">
                        <div class="input-group">
                            <label for="walletTopup">Top up wallet</label>
                            <input id="walletTopup" type="number" min="0" step="0.01" placeholder="10.00">
                        </div>
                        <button type="button" class="apply-btn" id="walletTopupBtn">Top up</button>
                    </div>
                </div>
                <a class="back-link" href="/cart">Back to cart</a>
                <h1>Select Payment Method</h1>

                <div class="method-list">
                    <div class="method-card" data-provider="PAYPAL">
                        <div class="method-info">
                            <div class="method-icon">P</div>
                            <div>
                                <div class="method-title">PayPal</div>
                                <div class="method-note">Secure checkout with PayPal.</div>
                            </div>
                        </div>
                        <div style="min-width:160px;">
                            <div id="paypal-button-container"></div>
                            <div id="paypal-error" style="display:none;">PayPal failed to load. Check PAYPAL_CLIENT_ID.</div>
                        </div>
                    </div>

                    <div class="method-card" data-provider="NETS">
                        <div class="method-info">
                            <div class="method-icon">N</div>
                            <div>
                                <div class="method-title">NETS</div>
                                <div class="method-note">Pay by scanning a NETS QR code.</div>
                            </div>
                        </div>
                        <button type="button" class="ghost-btn" id="netsBtn">Pay with NETS</button>
                    </div>

                    <div class="method-card" data-provider="STRIPE">
                        <div class="method-info">
                            <div class="method-icon">S</div>
                            <div>
                                <div class="method-title">Stripe</div>
                                <div class="method-note">Pay securely with Stripe Checkout.</div>
                            </div>
                        </div>
                        <button type="button" class="ghost-btn" id="stripeBtn">Pay with Stripe</button>
                    </div>

                    <div class="method-card" data-provider="STRIPE_PAYNOW">
                        <div class="method-info">
                            <div class="method-icon">PN</div>
                            <div>
                                <div class="method-title">PayNow (Stripe)</div>
                                <div class="method-note">Real PayNow test mode via Stripe.</div>
                            </div>
                        </div>
                        <button type="button" class="ghost-btn" id="stripePaynowBtn">PayNow</button>
                    </div>

                    <div class="method-card" data-provider="AIRWALLEX">
                        <div class="method-info">
                            <div class="method-icon">A</div>
                            <div>
                                <div class="method-title">Airwallex</div>
                                <div class="method-note">Airwallex hosted checkout (sandbox).</div>
                            </div>
                        </div>
                        <button type="button" class="ghost-btn" id="airwallexBtn">Pay with Airwallex</button>
                    </div>

                </div>
                <div class="plan-card">
                    <div>
                        <div class="plan-title">Recommended</div>
                        <div class="plan-desc">We suggest PayPal for fastest approval.</div>
                    </div>
                    <button type="button" class="ghost-btn">Use PayPal</button>
                </div>

                <div class="amount-card">
                    <div class="amount-label">You have to pay</div>
                    <div class="amount-value">$<%= (total || 0).toFixed(2) %></div>
                    <div class="tag"><span></span> Payment & Invoice</div>
                    <p class="method-note" style="margin-top:0.75rem;">
                        We will take care of your payment. You can relax while we prepare your items.
                    </p>

                    <div class="plan-card">
                        <div>
                            <div class="plan-title">Order Summary</div>
                            <div class="plan-desc"><%= (cart || []).length %> item(s) in cart</div>
                        </div>
                        <button type="button" class="ghost-btn">Change</button>
                    </div>
                </div>
            </section>

            <section class="panel right">
                <h2>Payment</h2>
                <p>Select a payment method on the left to continue.</p>
                <div class="fine-print" id="statusArea">Status: Ready.</div>
                <div id="airwallexQrWrap" style="display:none; margin-top:1rem;">
                    <div class="method-note">Scan the QR with your banking app.</div>
                    <img id="airwallexQrImg" alt="Airwallex QR" style="margin-top:0.75rem; max-width:240px; width:100%; height:auto; border-radius:12px; border:1px solid var(--line);" />
                </div>
            </section>
        </div>
    </div>

    <script>
        async function fetchWalletBalance() {
            const res = await fetch('/api/payments/wallet/balance');
            const data = await res.json();
            if (data && data.balance !== undefined) {
                document.getElementById('walletBalance').textContent = `$${Number(data.balance).toFixed(2)}`;
            }
        }
        fetchWalletBalance();

        async function createPayment(provider) {
            let walletUse = parseFloat(document.getElementById('walletUse').value || '0');
            if (Number.isNaN(walletUse)) {
                walletUse = 0;
            }
            const res = await fetch('/api/payments/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ provider, useWalletAmount: walletUse })
            });
            const data = await res.json();
            if (!res.ok && data && data.error) {
                console.warn('Payment create error:', data.error);
            }
            return data;
        }
        try {
            if (!window.paypal || !paypal.Buttons) {
                document.getElementById('paypal-error').style.display = 'block';
            } else {
                const paypalButtons = paypal.Buttons({
                    createOrder: function () {
                        return fetch('/api/paypal/create-order', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({})
                        })
                        .then((res) => res.json())
                        .then((data) => data.id);
                    },
                    onApprove: function (data) {
                        return fetch('/api/paypal/capture-order', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ orderID: data.orderID })
                        })
                        .then((res) => res.json())
                        .then((result) => {
                            if (result && result.success && result.orderId) {
                                window.location.href = '/checkout/success/' + result.orderId;
                            } else {
                                alert('Payment not completed.');
                            }
                        });
                    },
                    onError: function () {
                        alert('PayPal payment failed. Please try again.');
                    }
                });

                if (!paypalButtons) {
                    document.getElementById('paypal-error').style.display = 'block';
                } else {
                    paypalButtons.render('#paypal-button-container');
                }
            }
        } catch (err) {
            console.error('PayPal render failed:', err);
            document.getElementById('paypal-error').style.display = 'block';
        }

        async function topupWallet() {
            const amount = parseFloat(document.getElementById('walletTopup').value || '0');
            if (!amount || amount <= 0) {
                document.getElementById('statusArea').textContent = 'Status: Enter a valid topup amount.';
                return;
            }
            const res = await fetch('/api/payments/wallet/topup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount })
            });
            const data = await res.json();
            if (data && data.balance !== undefined) {
                document.getElementById('walletBalance').textContent = `$${Number(data.balance).toFixed(2)}`;
                document.getElementById('statusArea').textContent = 'Status: Wallet topped up.';
            }
        }

        document.getElementById('walletTopupBtn').addEventListener('click', topupWallet);

        document.getElementById('netsBtn').addEventListener('click', async () => {
            selectedProvider = 'NETS';
            document.getElementById('statusArea').textContent = 'Status: Redirecting to NETS QR...';
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/api/nets/generate-qr';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'cartTotal';
            input.value = '<%= (total || 0).toFixed(2) %>';
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        });

        document.getElementById('stripeBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to Stripe...';
            const data = await createPayment('STRIPE');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
            } else {
                document.getElementById('statusArea').textContent = 'Status: Stripe unavailable.';
            }
        });

        document.getElementById('stripePaynowBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to PayNow...';
            const data = await createPayment('STRIPE_PAYNOW');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
            } else {
                document.getElementById('statusArea').textContent = 'Status: PayNow unavailable.';
            }
        });

        document.getElementById('airwallexBtn').addEventListener('click', async () => {
            document.getElementById('statusArea').textContent = 'Status: Redirecting to Airwallex checkout...';
            const data = await createPayment('AIRWALLEX');
            if (data && data.error) {
                document.getElementById('statusArea').textContent = `Status: ${data.error}`;
                return;
            }
            if (data && data.providerData && data.providerData.checkoutUrl) {
                window.location.href = data.providerData.checkoutUrl;
                return;
            }
            if (data && data.providerData && data.providerData.qrCode) {
                const qrWrap = document.getElementById('airwallexQrWrap');
                const qrImg = document.getElementById('airwallexQrImg');
                qrImg.src = data.providerData.qrCode;
                qrWrap.style.display = 'block';
                document.getElementById('statusArea').textContent = 'Status: Scan the Airwallex QR code to complete payment.';
                return;
            }
            document.getElementById('statusArea').textContent = 'Status: Airwallex unavailable.';
        });

    </script>
</body>
</html>
