<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment - FreshMarket</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            position: relative;
            min-height: 100vh;
        }

        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.9);
            z-index: 0;
        }

        .nav, .container { position: relative; z-index: 1; }
        .nav { background:rgba(255,255,255,.95); padding:1rem 0; box-shadow:0 2px 10px rgba(0,0,0,.08); }
        .container { width:90%; max-width:1000px; margin:0 auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-weight:800; color:#667eea; font-size:1.25rem; }

        .payment-container { padding:2rem 0; }
        .card { background:#fff; border-radius:1rem; padding:2rem; box-shadow:0 4px 12px rgba(0,0,0,.05); margin-bottom:2rem; }
        h2 { margin-bottom:1rem; }

        .order-items { margin:1rem 0; }
        .order-item { display:flex; justify-content:space-between; padding:1rem; border-bottom:1px solid #eee; }
        .order-item:last-child { border:none; }

        .summary { background:#f8fafc; padding:1rem; border-radius:.5rem; margin:1rem 0; }
        .summary-row { display:flex; justify-content:space-between; padding:.5rem 0; }
        .summary-total { font-size:1.2rem; font-weight:600; color:#667eea; border-top:2px solid #e2e8f0; padding-top:1rem; margin-top:1rem; }

        .payment-methods { display:grid; gap:1rem; }
        .method-card { border:1px solid #e5e7eb; border-radius:.75rem; padding:1rem; }
        .method-title { font-weight:700; margin-bottom:.5rem; }
        .method-note { color:#6b7280; font-size:.9rem; }

        .btn { padding:1rem 2rem; border:none; border-radius:.5rem; font-weight:600; cursor:pointer; transition:all .2s; }
        .btn-primary { background:linear-gradient(135deg,#667eea,#764ba2); color:#fff; width:100%; }
        .btn-primary:hover { transform:translateY(-2px); box-shadow:0 4px 12px rgba(102,126,234,.3); }
    </style>
    <script src="https://www.paypal.com/sdk/js?client-id=<%= (process.env.PAYPAL_CLIENT_ID && process.env.PAYPAL_CLIENT_ID !== 'your_paypal_client_id') ? process.env.PAYPAL_CLIENT_ID : 'sb' %>&currency=SGD"></script>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">ðŸ›’ FreshMarket</div>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="payment-container">
            <div class="card">
                <h2>Payment</h2>
                <p style="color:#666">Choose a payment method</p>

                <div class="order-items">
                    <% (cart || []).forEach(function(item) { %>
                        <div class="order-item">
                            <div>
                                <strong><%= item.name %></strong>
                                <p style="color:#666;font-size:.9rem">Quantity: <%= item.quantity %></p>
                            </div>
                            <div style="text-align:right">
                                <strong>$<%= (item.price * item.quantity).toFixed(2) %></strong>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <div class="summary">
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>$<%= (total || 0).toFixed(2) %></span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping</span>
                        <span>Free</span>
                    </div>
                    <div class="summary-row summary-total">
                        <span>Total</span>
                        <span>$<%= (total || 0).toFixed(2) %></span>
                    </div>
                </div>

                <div class="payment-methods">
                    <div class="method-card">
                        <div class="method-title">PayPal</div>
                        <div id="paypal-button-container"></div>
                        <div id="paypal-error" class="method-note" style="display:none;color:#b91c1c;margin-top:.5rem;">
                            PayPal failed to load. Check your PAYPAL_CLIENT_ID and try again.
                        </div>
                        <div class="method-note">Secure checkout with PayPal.</div>
                    </div>

                    <div class="method-card" aria-disabled="true">
                        <div class="method-title">NETS</div>
                        <div class="method-note">Coming next.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        if (!window.paypal || !paypal.Buttons) {
            document.getElementById('paypal-error').style.display = 'block';
        } else {
            paypal.Buttons({
            createOrder: function () {
                return fetch('/api/paypal/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                })
                .then((res) => res.json())
                .then((data) => data.id);
            },
            onApprove: function (data) {
                return fetch('/api/paypal/capture-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderID: data.orderID })
                })
                .then((res) => res.json())
                .then((result) => {
                    if (result && result.success && result.orderId) {
                        window.location.href = '/checkout/success/' + result.orderId;
                    } else {
                        alert('Payment not completed.');
                    }
                });
            },
            onError: function () {
                alert('PayPal payment failed. Please try again.');
            }
            }).render('#paypal-button-container');
        }
    </script>
</body>
</html>
