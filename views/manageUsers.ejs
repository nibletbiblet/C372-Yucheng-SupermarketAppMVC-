<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users - FreshMarket Admin</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f8fafc; }
        .nav { background:#fff; padding:1rem 0; box-shadow:0 2px 10px rgba(0,0,0,.1); }
        .container { width:90%; max-width:1400px; margin:2rem auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-size:1.5rem; font-weight:900; color:#667eea; }
        .nav-links { display:flex; gap:1rem; }
        .nav-links a { color:#333; text-decoration:none; font-weight:600; padding:.5rem 1rem; border-radius:.5rem; transition:all .2s; }
        .nav-links a:hover { background:#667eea; color:#fff; }
        
        h1 { color:#333; margin-bottom:2rem; }
        
        .alert { padding:1rem; border-radius:.5rem; margin-bottom:1.5rem; }
        .alert-success { background:#d1fae5; color:#065f46; }
        .alert-error { background:#fef2f2; color:#991b1b; }
        
        .users-table {
            background:#fff;
            border-radius:1rem;
            padding:2rem;
            box-shadow:0 4px 15px rgba(0,0,0,.1);
            overflow-x:auto;
        }
        table { width:100%; border-collapse:collapse; }
        th { background:#667eea; color:#fff; padding:1rem; text-align:left; font-weight:600; }
        td { padding:1rem; border-bottom:1px solid #e2e8f0; }
        tr:hover { background:#f8fafc; }
        
        .badge {
            padding:.3rem .8rem;
            border-radius:.5rem;
            font-size:.85rem;
            font-weight:600;
        }
        .badge-admin { background:#fef3c7; color:#92400e; }
        .badge-user { background:#dbeafe; color:#1e40af; }
        
        .btn-delete {
            padding:.5rem 1rem;
            background:#ef4444;
            color:#fff;
            border:none;
            border-radius:.5rem;
            cursor:pointer;
            font-weight:600;
            transition:all .3s;
        }
        .btn-delete:hover { background:#dc2626; transform:translateY(-2px); }
        .btn-delete:disabled {
            background:#cbd5e1;
            cursor:not-allowed;
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">🛒 FreshMarket Admin</div>
                <div class="nav-links">
                    <a href="/admin/dashboard">Dashboard</a>
                    <a href="/inventory">Inventory</a>
                    <a href="/admin/users">Manage Users</a>
                    <a href="/logout">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <h1>👥 Manage Users</h1>
        
        <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
            <div class="alert alert-success"><%= messages[0] %></div>
        <% } %>
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <div class="alert alert-error"><%= errors[0] %></div>
        <% } %>
        
        <div class="users-table">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Address</th>
                        <th>Contact</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(userItem => { %>
                        <tr>
                            <td><%= userItem.id %></td>
                            <td><%= userItem.username %></td>
                            <td><%= userItem.email %></td>
                            <td>
                                <span class="badge <%= userItem.role === 'admin' ? 'badge-admin' : 'badge-user' %>">
                                    <%= userItem.role %>
                                </span>
                            </td>
                            <td><%= userItem.address %></td>
                            <td><%= userItem.contact %></td>
                            <td>
                                <% if (userItem.role !== 'admin') { %>
                                    <form action="/admin/delete-user/<%= userItem.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <button type="submit" class="btn-delete">🗑️ Delete</button>
                                    </form>
                                <% } else { %>
                                    <button class="btn-delete" disabled>Protected</button>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
