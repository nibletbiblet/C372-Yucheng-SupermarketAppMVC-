<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login / Register - FreshMarket</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            background: url('/images/backgrounds/login.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        body::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(102, 126, 234, 0.88);
            z-index: 0;
        }
        
        .container {
            position: relative;
            z-index: 1;
            perspective: 1000px;
            width: 90%;
            max-width: 900px;
        }
        
        .auth-wrapper {
            position: relative;
            width: 100%;
            min-height: 600px;
            transition: transform 0.8s;
            transform-style: preserve-3d;
        }
        
        .auth-wrapper.flipped {
            transform: rotateY(180deg);
        }
        
        .auth-card {
            position: absolute;
            width: 100%;
            backface-visibility: hidden;
            background: rgba(255,255,255,0.98);
            border-radius: 1.5rem;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        
        .auth-card.back {
            transform: rotateY(180deg);
        }
        
        .logo { text-align: center; margin-bottom: 2rem; }
        .logo h1 { font-size: 2.5rem; color: #667eea; }
        
        .form-title { text-align: center; margin-bottom: 2rem; color: #333; font-size: 1.8rem; }
        
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .form-group { margin-bottom: 1rem; }
        .form-group.full-width { grid-column: 1 / -1; }
        .form-group label { display: block; margin-bottom: .5rem; font-weight: 600; color: #555; }
        .form-group input, .form-group select {
            width: 100%;
            padding: .9rem;
            border: 2px solid #e2e8f0;
            border-radius: .5rem;
            font-size: 1rem;
            transition: all .3s;
        }
        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.1);
        }
        
        .password-wrapper { position: relative; }
        .toggle-password {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1.2rem;
        }
        
        .btn-submit {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border: none;
            border-radius: .7rem;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all .3s;
            margin-top: 1rem;
        }
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102,126,234,.4);
        }
        
        .switch-form {
            text-align: center;
            margin-top: 1.5rem;
            color: #666;
        }
        .switch-form button {
            background: none;
            border: none;
            color: #667eea;
            font-weight: 700;
            cursor: pointer;
            text-decoration: underline;
        }
        
        .alert {
            padding: 1rem;
            border-radius: .5rem;
            margin-bottom: 1rem;
            text-align: center;
        }
        .alert-error { background: #fef2f2; color: #991b1b; }
        .alert-success { background: #dcfce7; color: #065f46; }
        
        @media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
            .auth-card { padding: 2rem; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="auth-wrapper" id="authWrapper">
            <!-- Login Card (Front) -->
            <div class="auth-card front">
                <div class="logo">
                    <h1>🛒 FreshMarket</h1>
                </div>
                <h2 class="form-title">Welcome Back!</h2>
                
                <% if (errors && errors.length > 0) { %>
                    <div class="alert alert-error"><%= errors[0] %></div>
                <% } %>
                <% if (messages && messages.length > 0) { %>
                    <div class="alert alert-success"><%= messages[0] %></div>
                <% } %>
                
                <form action="/login" method="POST">
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" required placeholder="your@email.com" autocomplete="off">
                    </div>
                    
                    <div class="form-group">
                        <label>Password</label>
                        <div class="password-wrapper">
                            <input type="password" name="password" id="loginPassword" required placeholder="Enter your password" autocomplete="new-password">
                            <button type="button" class="toggle-password" onclick="togglePassword('loginPassword', this)">👁️</button>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn-submit">Login</button>
                </form>
                
                <div class="switch-form">
                    Don't have an account? <button type="button" onclick="flipCard()">Register here</button>
                </div>
            </div>
            
            <!-- Register Card (Back) -->
            <div class="auth-card back">
                <div class="logo">
                    <h1>🛒 FreshMarket</h1>
                </div>
                <h2 class="form-title">Create Account</h2>
                
                <% if (registerErrors && registerErrors.length > 0) { %>
                    <div class="alert alert-error"><%= registerErrors[0] %></div>
                <% } %>
                
                <form action="/register" method="POST">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" name="username" required placeholder="John Doe" value="<%= formData ? formData.username : '' %>">
                        </div>
                        
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" required placeholder="your@email.com" value="<%= formData ? formData.email : '' %>">
                        </div>
                        
                        <div class="form-group">
                            <label>Password</label>
                            <div class="password-wrapper">
                                <input type="password" name="password" id="regPassword" required placeholder="Min 8 characters" autocomplete="new-password">
                                <button type="button" class="toggle-password" onclick="togglePassword('regPassword', this)">👁️</button>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label>Confirm Password</label>
                            <div class="password-wrapper">
                                <input type="password" name="confirmPassword" id="confirmPassword" required placeholder="Re-enter password" autocomplete="new-password">
                                <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)">👁️</button>
                            </div>
                        </div>
                        
                        <div class="form-group full-width">
                            <label>Address</label>
                            <input type="text" name="address" required placeholder="123 Street Name" value="<%= formData ? formData.address : '' %>">
                        </div>
                        
                        <div class="form-group">
                            <label>Contact Number</label>
                            <input type="tel" name="contact" required placeholder="+65 1234 5678" value="<%= formData ? formData.contact : '' %>">
                        </div>
                        
                        <div class="form-group">
                            <label>Account Type</label>
                            <select name="role" required>
                                <option value="">Select Role</option>
                                <option value="user">Customer</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn-submit">Create Account</button>
                </form>
                
                <div class="switch-form">
                    Already have an account? <button type="button" onclick="flipCard()">Login here</button>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        function flipCard() {
            document.getElementById('authWrapper').classList.toggle('flipped');
        }
        
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                button.textContent = '🙈';
            } else {
                input.type = 'password';
                button.textContent = '👁️';
            }
        }
        
        // Auto-flip to register if there are register errors
        <% if (registerErrors && registerErrors.length > 0) { %>
            flipCard();
        <% } %>
    </script>
</body>
</html>
