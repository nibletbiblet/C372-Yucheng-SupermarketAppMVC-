<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Orders - FreshMarket</title>
    <style>
        * { box-sizing:border-box; }
        body { margin:0; font-family:'Segoe UI', sans-serif; background:#f8fafc; color:#111827; }
        .nav { background:#fff; padding:1rem 0; box-shadow:0 2px 10px rgba(0,0,0,.08); }
        .container { width:92%; max-width:1300px; margin:2rem auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-size:1.5rem; font-weight:900; color:#4f46e5; }
        .nav-links { display:flex; gap:1rem; }
        .nav-links a { color:#333; text-decoration:none; font-weight:600; padding:.5rem 1rem; border-radius:.5rem; }
        .nav-links a:hover { background:#4f46e5; color:#fff; }
        h1 { margin-bottom:1.5rem; }
        table { width:100%; border-collapse:collapse; background:#fff; border-radius:12px; overflow:hidden; }
        th, td { padding:0.9rem; border-bottom:1px solid #e5e7eb; text-align:left; }
        th { background:#f3f4f6; font-weight:700; }
        .badge { padding:.25rem .6rem; border-radius:999px; font-size:.8rem; font-weight:600; }
        .badge.pending { background:#fef3c7; color:#92400e; }
        .badge.paid { background:#dcfce7; color:#166534; }
        .badge.held { background:#cffafe; color:#155e75; }
        .badge.refunded { background:#e0f2fe; color:#075985; }
        .badge.partial_refunded { background:#cffafe; color:#155e75; }
        .badge.none { background:#e5e7eb; color:#374151; }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">FreshMarket Admin</div>
                <div class="nav-links">
                    <a href="/admin/dashboard">Dashboard</a>
                    <a href="/admin/orders">Orders</a>
                    <a href="/admin/refunds/requests">Refunds</a>
                    <a href="/logout">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <h1>Order History</h1>
        <table>
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>User</th>
                    <th>Total</th>
                    <th>Created</th>
                    <th>Order Status</th>
                    <th>Payment Status</th>
                    <th>Refund Status</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <% const orderStatus = String(order.status || 'PENDING').toLowerCase(); %>
                    <% const paymentStatus = String(order.payment_status || 'NONE').toLowerCase(); %>
                    <% const refundStatus = String(order.refund_status || 'NONE').toLowerCase(); %>
                    <tr>
                        <td>#<%= order.order_id %></td>
                        <td><%= order.username %></td>
                        <td>$<%= parseFloat(order.total_price || 0).toFixed(2) %></td>
                        <td><%= new Date(order.created_at || Date.now()).toLocaleString() %></td>
                        <td><span class="badge <%= orderStatus %>"><%= orderStatus.toUpperCase() %></span></td>
                        <td><span class="badge <%= paymentStatus %>"><%= paymentStatus.toUpperCase() %></span></td>
                        <td><span class="badge <%= refundStatus %>"><%= refundStatus.toUpperCase() %></span></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</body>
</html>
