<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreshMarket - Fresh Groceries Delivered</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            background: url('/images/backgrounds/landing.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }
        
        .nav {
            background: rgba(255,255,255,0.98);
            padding: 1rem 0;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .container { width:90%; max-width:1200px; margin:0 auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-size:1.8rem; font-weight:900; color:#667eea; display:flex; align-items:center; gap:.5rem; }
        .nav-links { display:flex; gap:1.5rem; align-items:center; }
        .nav-links a { color:#333; text-decoration:none; font-weight:600; padding:.5rem 1rem; border-radius:.5rem; transition:all .3s; }
        .nav-links a:hover { background:#667eea; color:#fff; }
        .btn-login { background:#667eea; color:#fff; padding:.7rem 1.5rem; }
        
        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, rgba(102,126,234,0.95), rgba(118,75,162,0.95));
            padding: 5rem 0;
            text-align: center;
            color: white;
            margin: 2rem 0;
            border-radius: 1rem;
            position: relative;
            overflow: hidden;
        }
        .hero h1 { font-size: 3.5rem; margin-bottom: 1rem; animation: fadeInDown 1s; }
        .hero p { font-size: 1.3rem; margin-bottom: 2rem; opacity: 0.95; }
        .hero-btns { display: flex; gap: 1rem; justify-content: center; }
        .btn-hero { padding: 1rem 2.5rem; border: none; border-radius: .7rem; font-weight: 700; font-size: 1.1rem; cursor: pointer; transition: all .3s; text-decoration: none; display: inline-block; }
        .btn-hero-primary { background: #fff; color: #667eea; }
        .btn-hero-primary:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); }
        .btn-hero-secondary { background: transparent; color: #fff; border: 2px solid #fff; }
        .btn-hero-secondary:hover { background: #fff; color: #667eea; }
        
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Categories Section */
        .section { padding: 3rem 0; }
        .section-title { text-align: center; font-size: 2.5rem; margin-bottom: 2rem; color: #333; }
        .categories { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
        .category-card {
            background: rgba(255,255,255,0.95);
            padding: 2rem;
            border-radius: 1rem;
            text-align: center;
            cursor: pointer;
            transition: all .3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
        }
        .category-icon { font-size: 4rem; margin-bottom: 1rem; }
        .category-card h3 { color: #667eea; margin-bottom: .5rem; }
        
        /* Features Section */
        .features {
            background: rgba(255,255,255,0.95);
            padding: 4rem 2rem;
            border-radius: 1rem;
            margin: 3rem 0;
        }
        .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem; }
        .feature-item {
            text-align: center;
            padding: 2rem;
        }
        .feature-icon { font-size: 3rem; margin-bottom: 1rem; }
        .feature-item h3 { color: #667eea; margin-bottom: .5rem; }
        
        /* Footer */
        .footer {
            background: rgba(51,51,51,0.95);
            color: #fff;
            padding: 3rem 0 1rem;
            margin-top: 3rem;
        }
        .footer-content { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 2rem; }
        .footer h4 { margin-bottom: 1rem; color: #667eea; }
        .footer a { color: #ccc; text-decoration: none; display: block; margin: .5rem 0; }
        .footer a:hover { color: #fff; }
        .footer-bottom { text-align: center; padding-top: 2rem; border-top: 1px solid #555; color: #999; }
        
        @media (max-width: 768px) {
            .hero h1 { font-size: 2rem; }
            .hero p { font-size: 1rem; }
            .hero-btns { flex-direction: column; }
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">🛒 FreshMarket</div>
                <div class="nav-links">
                    <a href="/">Home</a>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                    <% if (user) { %>
                        <% if (user.role === 'admin') { %>
                            <a href="/inventory">Inventory</a>
                        <% } else { %>
                            <a href="/shopping">Shop</a>
                        <% } %>
                        <a href="/logout">Logout</a>
                    <% } else { %>
                        <a href="/login" class="btn-login">Login</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Hero Section -->
        <div class="hero">
            <h1>🌟 Fresh Groceries Delivered to Your Door</h1>
            <p>Quality products, unbeatable prices, delivered fresh daily</p>
            <div class="hero-btns">
                <a href="<%= user ? '/shopping' : '/login' %>" class="btn-hero btn-hero-primary">Start Shopping</a>
                <a href="/about" class="btn-hero btn-hero-secondary">Learn More</a>
            </div>
        </div>

        <!-- Categories Section -->
        <div class="section">
            <h2 class="section-title">Shop by Category</h2>
            <div class="categories">
                <div class="category-card" onclick="window.location.href='/shopping'">
                    <div class="category-icon">🍎</div>
                    <h3>Fresh Fruits</h3>
                    <p>Farm-fresh seasonal fruits</p>
                </div>
                <div class="category-card" onclick="window.location.href='/shopping'">
                    <div class="category-icon">🥬</div>
                    <h3>Vegetables</h3>
                    <p>Organic & locally sourced</p>
                </div>
                <div class="category-card" onclick="window.location.href='/shopping'">
                    <div class="category-icon">🥛</div>
                    <h3>Dairy Products</h3>
                    <p>Fresh milk, cheese & more</p>
                </div>
                <div class="category-card" onclick="window.location.href='/shopping'">
                    <div class="category-icon">🍖</div>
                    <h3>Meat & Seafood</h3>
                    <p>Premium quality cuts</p>
                </div>
            </div>
        </div>

        <!-- Features Section -->
        <div class="features">
            <h2 class="section-title">Why Choose FreshMarket?</h2>
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon">🚚</div>
                    <h3>Free Delivery</h3>
                    <p>On orders over $50</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">✅</div>
                    <h3>Quality Guarantee</h3>
                    <p>100% satisfaction or money back</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">⚡</div>
                    <h3>Fast Checkout</h3>
                    <p>Secure & easy payment process</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">💰</div>
                    <h3>Best Prices</h3>
                    <p>Competitive pricing daily</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <div class="container">
            <div class="footer-content">
                <div>
                    <h4>About FreshMarket</h4>
                    <p>Your trusted partner for fresh groceries and everyday essentials.</p>
                </div>
                <div>
                    <h4>Quick Links</h4>
                    <a href="/shopping">Shop</a>
                    <a href="/about">About Us</a>
                    <a href="/contact">Contact</a>
                </div>
                <div>
                    <h4>Customer Service</h4>
                    <a href="/faq">FAQ</a>
                    <a href="/shipping">Shipping Info</a>
                    <a href="/returns">Returns</a>
                </div>
                <div>
                    <h4>Contact</h4>
                    <p>📧 support@freshmarket.com</p>
                    <p>📞 +65 1234 5678</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 FreshMarket. All rights reserved.</p>
            </div>
        </div>
    </div>
</body>
</html>