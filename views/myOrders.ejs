<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline';">
    <title>My Orders - FreshMarket</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { background:linear-gradient(135deg,#f5f7ff,#eef6fb); min-height:100vh; font-family:'Segoe UI',Roboto,Arial; }
        .nav { background:rgba(255,255,255,.95); padding:1rem 0; box-shadow:0 2px 10px rgba(0,0,0,.08); }
        .container { width:90%; max-width:1200px; margin:0 auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-weight:800; color:#667eea; font-size:1.25rem; }
        .nav-links { display:flex; gap:12px; }
        .nav-links a { padding:.4rem .8rem; border-radius:.5rem; text-decoration:none; color:#444; transition:all .2s; }
        .nav-links a:hover { background:#667eea; color:#fff; }
        
        .orders-container { padding:2rem 0; }
        .order-card { background:#fff; border-radius:1rem; padding:1.5rem; margin-bottom:1rem; box-shadow:0 4px 12px rgba(0,0,0,.05); }
        .order-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:1rem; border-bottom:1px solid #eee; }
        .order-date { color:#666; font-size:.9rem; }
        .order-total { font-weight:600; color:#667eea; font-size:1.1rem; }
        .empty { text-align:center; padding:3rem; background:#fff; border-radius:1rem; }
        .btn { padding:.5rem 1rem; background:#667eea; color:#fff; border-radius:.5rem; text-decoration:none; font-size:.9rem; transition:all .2s; }
        .btn:hover { background:#5568d3; transform:translateY(-2px); }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">🛒 FreshMarket</div>
                <div class="nav-links">
                    <a href="/shopping">Shop</a>
                    <a href="/cart">Cart</a>
                    <a href="/checkout/orders">My Orders</a>
                    <a href="/logout">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="orders-container">
            <h2 style="margin-bottom:1.5rem">My Orders</h2>
            
            <% if (!orders || orders.length === 0) { %>
                <div class="empty">
                    <h3>No orders yet</h3>
                    <p style="color:#666;margin:1rem 0">Start shopping to place your first order</p>
                    <a href="/shopping" class="btn">Shop Now</a>
                </div>
            <% } else { %>
                <% orders.forEach(function(order) { %>
                    <div class="order-card">
                        <div class="order-header">
                            <div>
                                <strong>Order #<%= order.order_id %></strong>
                                <div class="order-date"><%= new Date(order.created_at).toLocaleDateString() %></div>
                            </div>
                            <div class="order-total">$<%= Number(order.total_price).toFixed(2) %></div>
                        </div>
                        <div style="display:flex;justify-content:space-between;align-items:center">
                            <p style="color:#666"><%= order.item_count || 0 %> item(s)</p>
                            <a href="/checkout/invoice/<%= order.order_id %>" class="btn">View Invoice</a>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</body>
</html>
