<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - FreshMarket</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            background: url('/images/backgrounds/user.jpg') no-repeat center center fixed;
            background-size: cover;
            position: relative;
            min-height: 100vh;
        }
        
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.3);  /* Reduced from 0.92 to 0.3 */
            z-index: 0;
        }
        
        .nav, .container { position: relative; z-index: 1; }
        .nav { background:rgba(255,255,255,.95); padding:1rem 0; box-shadow:0 2px 10px rgba(0,0,0,.08); }
        .container { width:90%; max-width:1200px; margin:0 auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-weight:800; color:#667eea; font-size:1.25rem; }
        .nav-links { display:flex; gap:12px; }
        .nav-links a { padding:.4rem .8rem; border-radius:.5rem; text-decoration:none; color:#444; transition:all .2s; }
        .nav-links a:hover { background:#667eea; color:#fff; }
        
        .cart-container { display:grid; grid-template-columns:1fr 360px; gap:2rem; padding:2rem 0; }
        .cart-items { background:#fff; border-radius:1rem; padding:1.5rem; box-shadow:0 4px 12px rgba(0,0,0,.05); }
        .cart-item { display:grid; grid-template-columns:100px 1fr auto; gap:1rem; align-items:center; padding:1rem; border-bottom:1px solid #eee; }
        .cart-item:last-child { border:none; }
        .item-img { width:100%; aspect-ratio:1; object-fit:cover; border-radius:.5rem; }
        .item-info h3 { font-size:1.1rem; margin-bottom:.25rem; }
        .item-price { color:#667eea; font-weight:600; }
        
        .quantity-controls { display:flex; align-items:center; gap:.5rem; }
        .qty-btn { padding:.5rem; width:32px; height:32px; border:none; border-radius:.5rem; background:#f1f5f9; cursor:pointer; transition:all .2s; }
        .qty-btn:hover { background:#e2e8f0; }
        
        .cart-summary { background:#fff; border-radius:1rem; padding:1.5rem; position:sticky; top:2rem; box-shadow:0 4px 12px rgba(0,0,0,.05); }
        .summary-row { display:flex; justify-content:space-between; padding:.75rem 0; border-bottom:1px solid #eee; }
        .summary-row:last-child { border:none; font-size:1.2rem; font-weight:600; color:#667eea; }
        
        .btn { display:block; width:100%; padding:1rem; margin-top:1rem; border:none; border-radius:.5rem; font-weight:600; cursor:pointer; transition:all .2s; text-align:center; text-decoration:none; }
        .btn-primary { background:linear-gradient(135deg,#667eea,#764ba2); color:#fff; }
        .btn-primary:hover { transform:translateY(-2px); box-shadow:0 4px 12px rgba(102,126,234,.3); }
        .btn-secondary { background:#eef2ff; color:#374151; }
        .btn-danger { background:#fee2e2; color:#991b1b; padding:.5rem 1rem; }
        
        .empty-cart { text-align:center; padding:3rem 1rem; background:#fff; border-radius:1rem; grid-column:1/-1; }
        .alert { padding:1rem; border-radius:.5rem; margin-bottom:1rem; }
        .alert-success { background:#dcfce7; color:#065f46; }
        .alert-error { background:#fef2f2; color:#991b1b; }
        
        @media (max-width: 768px) {
            .cart-container { grid-template-columns: 1fr; }
            .cart-item { grid-template-columns: 80px 1fr; gap: 0.75rem; }
            .quantity-controls { grid-column: 1 / -1; justify-content: flex-start; margin-top: 0.5rem; }
            .cart-summary { position: static; }
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">🛒 FreshMarket</div>
                <div class="nav-links">
                    <a href="/shopping">Shop</a>
                    <a href="/cart">Cart</a>
                    <a href="/checkout/orders">My Orders</a>
                    <a href="/logout">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-success"><%= messages[0] %></div>
        <% } %>
        <% if (errors && errors.length > 0) { %>
            <div class="alert alert-error"><%= errors[0] %></div>
        <% } %>

        <div class="cart-container">
            <% if (!cart || cart.length === 0) { %>
                <div class="empty-cart">
                    <h2>Your cart is empty</h2>
                    <p style="color:#666;margin:1rem 0">Browse our products and add some items</p>
                    <a href="/shopping" class="btn btn-primary" style="display:inline-block;width:auto;padding:.75rem 2rem">Continue Shopping</a>
                </div>
            <% } else { %>
                <div class="cart-items">
                    <h2 style="margin-bottom:1.5rem">Shopping Cart (<%= cart.length %> items)</h2>
                    <% cart.forEach(function(item) { %>
                        <div class="cart-item">
                            <img src="/images/<%= item.image %>" alt="<%= item.name %>" class="item-img">
                            <div class="item-info">
                                <h3><%= item.name %></h3>
                                <p class="item-price">$<%= item.price.toFixed(2) %></p>
                                <form action="/cart/update/<%= item.id %>" method="POST" style="margin-top:.5rem">
                                    <div class="quantity-controls">
                                        <button type="submit" name="quantity" value="<%= Math.max(1, item.quantity - 1) %>" class="qty-btn">-</button>
                                        <span><%= item.quantity %></span>
                                        <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="qty-btn">+</button>
                                    </div>
                                </form>
                            </div>
                            <div style="text-align:right">
                                <div style="font-weight:600;margin-bottom:.5rem">$<%= (item.price * item.quantity).toFixed(2) %></div>
                                <form action="/cart/remove/<%= item.id %>" method="POST">
                                    <button type="submit" class="btn-danger">Remove</button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <div class="cart-summary">
                    <h3 style="margin-bottom:1rem">Order Summary</h3>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>$<%= total.toFixed(2) %></span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping</span>
                        <span style="color:#10b981">Free</span>
                    </div>
                    <div class="summary-row">
                        <span>Total</span>
                        <span>$<%= total.toFixed(2) %></span>
                    </div>
                    <a href="/checkout/payment" class="btn btn-primary">Proceed to Payment</a>
                    <a href="/shopping" class="btn btn-secondary">Continue Shopping</a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
