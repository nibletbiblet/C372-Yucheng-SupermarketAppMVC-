<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://unpkg.com/event-source-polyfill"></script>
    <style>
        body { font-family: Arial, sans-serif; padding: 2rem; }
        .card { max-width: 520px; margin: 0 auto; text-align: center; }
        img { max-width: 320px; width: 100%; height: auto; margin: 1rem 0; }
        .muted { color: #6b7280; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Scan the NETS QR</h1>
        <p id="status" class="muted">Scan with your NETS app to complete payment</p>
        <img src="<%= qrCodeUrl %>" alt="NETS QR Code" />
        <p id="timer" class="muted">Time remaining: 5:00</p>
        <a href="/checkout/payment">Cancel</a>
    </div>

    <script>
        let s2sNetsTxnStatus;
        const txnRetrievalRef = "<%= txnRetrievalRef %>";
        const orderId = "<%= (typeof orderId !== 'undefined' && orderId) ? orderId : '' %>";
        const url = `/sse/payment-status/${txnRetrievalRef}`;

        s2sNetsTxnStatus = new EventSourcePolyfill(url, { heartbeatTimeout: 150000 });

        s2sNetsTxnStatus.addEventListener("message", async (event) => {
            const data = JSON.parse(event.data);
            const netsData = data?.result?.data || {};
            const isSuccess = data.success || (netsData.response_code === "00" && netsData.txn_status === 1);
            const isFail = data.fail || (netsData.response_code !== "00" && netsData.txn_status === 2);

            if (isSuccess) {
                s2sNetsTxnStatus.close();
                try {
                    await fetch('/api/payments/callback/nets', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ txnRetrievalRef })
                    });
                } catch (err) {
                    // Continue with redirect even if callback fails
                }
                if (orderId) {
                    window.location.href = `/checkout/success/${orderId}`;
                } else {
                    window.location.href = `/nets-qr/success?txn_retrieval_ref=${txnRetrievalRef}`;
                }
                return;
            }

            if (isFail) {
                s2sNetsTxnStatus.close();
                window.location.href = `/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
            }
        });

        async function pollNetsStatus() {
            try {
                const res = await fetch(`/api/nets/query/${txnRetrievalRef}`);
                const data = await res.json();
                const netsData = data?.result?.data || {};
                const isSuccess = netsData.response_code === "00" && netsData.txn_status === 1;
                const isFail = netsData.response_code !== "00" && netsData.txn_status === 2;
                if (isSuccess) {
                    if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
                    await fetch('/api/payments/callback/nets', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ txnRetrievalRef })
                    });
                    if (orderId) {
                        window.location.href = `/checkout/success/${orderId}`;
                    } else {
                        window.location.href = `/nets-qr/success?txn_retrieval_ref=${txnRetrievalRef}`;
                    }
                    return;
                }
                if (isFail) {
                    if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
                    window.location.href = `/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
                }
            } catch (err) {
                // Ignore polling errors
            }
        }

        const pollInterval = setInterval(pollNetsStatus, 4000);

        const timerElement = document.getElementById("timer");
        const countdownDuration = 300;
        let remainingTime = countdownDuration;

        const updateTimer = () => {
            const minutes = Math.floor(remainingTime / 60);
            const seconds = remainingTime % 60;
            timerElement.textContent = `Time remaining: ${minutes}:${seconds.toString().padStart(2, "0")}`;
            remainingTime--;

            if (remainingTime < 0) {
                clearInterval(timerInterval);
                timerElement.textContent = "Transaction timed out.";
                if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
                window.location.href = `/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
            }
        };

        const timerInterval = setInterval(updateTimer, 1000);
        updateTimer();
    </script>
</body>
</html>
