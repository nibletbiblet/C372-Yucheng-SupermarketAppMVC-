<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders - FreshMarket</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f8fafc; }
        .nav { background:#fff; padding:1rem 0; box-shadow:0 2px 10px rgba(0,0,0,.1); }
        .container { width:90%; max-width:1200px; margin:2rem auto; }
        .nav-content { display:flex; justify-content:space-between; align-items:center; }
        .logo { font-size:1.5rem; font-weight:900; color:#667eea; }
        .nav-links { display:flex; gap:1rem; }
        .nav-links a { color:#333; text-decoration:none; font-weight:600; padding:.5rem 1rem; border-radius:.5rem; transition:all .2s; }
        .nav-links a:hover { background:#667eea; color:#fff; }
        
        h1 { color:#333; margin-bottom:2rem; }
        
        .orders-list { display:flex; flex-direction:column; gap:1.5rem; }
        .order-card {
            background:#fff;
            border-radius:1rem;
            padding:2rem;
            box-shadow:0 4px 15px rgba(0,0,0,.1);
            transition:all .3s;
        }
        .order-card:hover { transform:translateY(-5px); box-shadow:0 8px 25px rgba(0,0,0,.15); }
        
        .order-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:1rem; border-bottom:2px solid #f1f5f9; }
        .order-id { font-size:1.2rem; font-weight:700; color:#667eea; }
        .order-date { color:#666; }
        .order-total { font-size:1.5rem; font-weight:700; color:#10b981; }
        
        .order-status {
            padding:.5rem 1rem;
            border-radius:.5rem;
            font-weight:600;
            font-size:.9rem;
        }
        .status-pending { background:#fef3c7; color:#92400e; }
        .status-paid, .status-held { background:#d1fae5; color:#065f46; }
        .status-refunded { background:#e0f2fe; color:#075985; }
        .status-partial_refunded { background:#cffafe; color:#155e75; }
        .status-cancelled { background:#fee2e2; color:#991b1b; }
        .order-actions { display:flex; gap:.75rem; align-items:center; flex-wrap:wrap; margin-top:1rem; }
        .btn-secondary { background:#eef2ff; color:#667eea; }
        .btn-secondary:hover { background:#e0e7ff; color:#4c51bf; }
        .order-meta { color:#6b7280; margin-top:.5rem; font-size:.9rem; }
        
        .btn { padding:.7rem 1.5rem; background:#667eea; color:#fff; border:none; border-radius:.5rem; font-weight:600; cursor:pointer; text-decoration:none; display:inline-block; transition:all .3s; }
        .btn:hover { background:#764ba2; transform:translateY(-2px); }
        
        .empty-state { text-align:center; padding:4rem 2rem; }
        .empty-state h2 { color:#666; margin-bottom:1rem; }
        
        @media (max-width: 768px) {
            .order-header { flex-direction:column; align-items:flex-start; gap:1rem; }
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container">
            <div class="nav-content">
                <div class="logo">🛒 FreshMarket</div>
                <div class="nav-links">
                    <a href="/shopping">Shop</a>
                    <a href="/cart">Cart</a>
                    <a href="/checkout/orders">My Orders</a>
                    <a href="/logout">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <h1>📦 My Orders</h1>
        
        <% if (orders.length === 0) { %>
            <div class="empty-state">
                <h2>No orders yet</h2>
                <p style="color:#999;margin-bottom:2rem">Start shopping to place your first order!</p>
                <a href="/shopping" class="btn">Start Shopping</a>
            </div>
        <% } else { %>
            <div class="orders-list">
                <% orders.forEach(order => { %>
                    <div class="order-card">
                        <div class="order-header">
                            <div>
                                <div class="order-id">Order #<%= order.order_id %></div>
                                <div class="order-date">
                                    <%= new Date(order.created_at || Date.now()).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </div>
                            </div>
                            <div style="text-align:right">
                                <div class="order-total">$<%= parseFloat(order.total_price || 0).toFixed(2) %></div>
                                <% const statusRaw = String(order.status || 'PENDING').toUpperCase(); %>
                                <span class="order-status status-<%= statusRaw.toLowerCase() %>"><%= statusRaw %></span>
                            </div>
                        </div>
                        <% const refundableStatuses = ['PAID', 'HELD', 'PARTIAL_REFUNDED']; %>
                        <div class="order-meta">
                            Refund eligibility: <strong><%= refundableStatuses.includes(statusRaw) ? 'Eligible' : 'Not eligible' %></strong>
                        </div>
                        <div class="order-actions">
                            <a href="/checkout/invoice/<%= order.order_id %>" class="btn">View Details</a>
                            <a href="/refunds?orderId=<%= order.order_id %>" class="btn btn-secondary">Request Refund</a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</body>
</html>
